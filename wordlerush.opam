# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A terminal-based, multi-mode Wordle game written in OCaml"
description:
  "WordleRush is an interactive terminal Wordle game featuring timed and untimed modes, selectable word lengths (4/5/6 letters), difficulty levels, hints, and score tracking. It uses Lwt for a non-blocking countdown timer that runs concurrently with keyboard input, and ANSITerminal for colored output."
maintainer: ["Mohammad Labadi"]
authors: ["Mohammad Labadi"]
homepage: "https://github.com/mohdLabadi/WordleRush-Terminal-Game"
bug-reports: "https://github.com/mohdLabadi/WordleRush-Terminal-Game/issues"
depends: [
  "dune" {>= "3.10"}
  "ocaml" {>= "4.14"}
  "ANSITerminal"
  "lwt"
  "lwt_ssl"
  "ounit2" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/mohdLabadi/WordleRush-Terminal-Game.git"
